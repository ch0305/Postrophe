[Desktop Entry]
Name=Postrophe
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=postrophe;apostrophe;markdown;editor;
Comment=A fork of Apostrophe, a simple and distraction free Markdown editor
Categories=GNOME;GTK;Office;
Exec=postrophe %U
Icon=@icon@
Terminal=false
Type=Application
MimeType=text/x-markdown;text/plain;
